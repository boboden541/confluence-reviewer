<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Шаблон LaunchAgent для автозапуска CONNECT-прокси (см. README, раздел
     «Корпоративная сеть»). Установка:
     cp tools/com.confluence-reviewer.connect-proxy.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.confluence-reviewer.connect-proxy.plist
     Удаление: launchctl unload … && rm ~/Library/LaunchAgents/… -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.confluence-reviewer.connect-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO__/tools/connect_proxy.py</string>
        <string>--bind</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>3128</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/confluence-reviewer-proxy.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/confluence-reviewer-proxy.log</string>
</dict>
</plist>
