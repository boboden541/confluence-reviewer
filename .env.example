# ============================================================
# Confluence Reviewer — пример конфигурации (.env)
# Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env — он в .gitignore.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=confluence_reviewer
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=confluence_reviewer
# Внутри docker-compose сеть; для локального запуска замените host на localhost
DATABASE_URL=postgresql+psycopg2://confluence_reviewer:change-me-strong-password@db:5432/confluence_reviewer

# --- Безопасность приложения ---
# Basic-аутентификация UI/API (НФТ-CR-7). AUTH_ENABLED=false отключает защиту
# (только для локальной разработки!)
AUTH_ENABLED=true
APP_USERNAME=reviewer
APP_PASSWORD=change-me-strong-password

# --- Confluence (Data Center / Server) ---
CONFLUENCE_BASE_URL=https://confluence.example.ru
# Тип авторизации: bearer (Personal Access Token) | basic (login + password/token)
CONFLUENCE_AUTH_TYPE=bearer
CONFLUENCE_TOKEN=your-personal-access-token
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
# Как сопоставлять автора страницы с карточкой аналитика:
# email    — CQL creator = "<email>"
# username — CQL creator = "<confluence username>"
# auto     — сначала email, при пустом результате — локальная часть email до @
CONFLUENCE_CREATOR_FIELD=auto

# --- Синхронизация ---
SYNC_INTERVAL_HOURS=24
CONFLUENCE_PAGE_SIZE=25
CONFLUENCE_MAX_PAGES=500
# Пауза между запросами к API, сек (НФТ-CR-6: не более 10 req/s)
CONFLUENCE_REQUEST_DELAY=0.2

# --- ИИ-валидация ---
# env — загрузочные дефолты: настройки из UI («Подключение ИИ», таблица
# ai_connection_settings) перекрывают их по-полю; пустое поле в UI = env.
# AI_PROTOCOL: anthropic (z.ai/GLM, DeepSeek, Kimi…) | openai (OpenAI, OpenRouter, Ollama…)
AI_PROTOCOL=anthropic
AI_BASE_URL=https://api.z.ai/api/anthropic
AI_API_KEY=your-ai-api-key
AI_MODEL=glm-4.5
AI_MAX_TOKENS=4000
AI_TIMEOUT_SECONDS=180
# Токен из UI хранится в БД и наружу отдаётся только маской; поиск по смыслу
# всегда ходит через AI_BASE_URL/AI_SEARCH_MODEL из env (настройками UI не переключается)
AI_SEARCH_MODEL=glm-4.5-air

# --- Шаблон требований ---
# Путь внутри контейнера backend; для локального запуска — путь от backend/
TEMPLATE_FILE=app/templates/requirements_template.json

# --- Первичное наполнение (опционально) ---
# Формат: "ФИО:email;ФИО:email;..." — карточки создаются при старте, если их нет
SEED_ANALYSTS=

# --- Корпоративная сеть (docker) ---
# Если внутренний Confluence достижим только с хоста (VPN): запускайте
# python3 tools/connect_proxy.py и укажите прокси контейнеру.
# CA-бандл: security find-certificate -a -p -c "MTS" /Library/Keychains/System.keychain > docker/ca/mts-root-cas.pem
# HTTPS_PROXY=http://host.docker.internal:3128
# NO_PROXY=localhost,127.0.0.1,db,host.docker.internal
#   (host.docker.internal — если ИИ из UI указан как локальный Ollama)
# CONFLUENCE_CA_BUNDLE=/certs/mts-root-cas.pem
